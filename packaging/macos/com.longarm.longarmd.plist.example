<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference only: `longarmd service install --user <name>` writes the real
     /Library/LaunchDaemons/com.longarm.longarmd.plist (UserName, KeepAlive, AbandonProcessGroup). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.longarm.longarmd</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/longarmd</string><string>run</string></array>
  <key>UserName</key><string>alice</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>AbandonProcessGroup</key><true/>
</dict>
</plist>
