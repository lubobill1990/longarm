# /etc/longarm/join.env - read once by the package's postinst (then renamed
# to join.env.done). The same variables can be passed in the environment:
#   sudo env LONGARM_ROLES=worker LONGARM_HUB=hub.example.com LONGARM_JOIN_CODE=K7P-Q2M LONGARM_USER=alice apt install ./longarm_*.deb
LONGARM_ROLES=worker            # worker | client | both
LONGARM_HUB=                    # hub address (host[:7443])
LONGARM_JOIN_CODE=              # one-time join code (longarm admin join-code)
LONGARM_CA_FINGERPRINT=         # optional: pin the hub CA (longarm-hub ca show)
LONGARM_USER=                   # account longarmd runs as (longarmd@<user>.service); also gets the client config
