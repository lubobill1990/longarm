#!/bin/bash
# longarm-hub-deploy-docker: longarm-hub-deploy (same commands, same exit
# status, same CI side: .github/scripts/hub-deploy.sh) for a hub that runs as
# a container of the published image (ghcr.io/<owner>/longarm-hub:<version>).
#
# Install:
#   install -o root -g root -m 0755 deploy/hub/longarm-hub-deploy-docker /usr/local/bin/longarm-hub-deploy-docker
#   /etc/longarm-hub-deploy-docker.conf (root-owned, bash):
#     IMAGE=ghcr.io/<owner>/longarm-hub         # without the tag
#     NAME=longarm-hub                          # the container
#     VOLUME=longarm-hub-data                   # its data volume (snapshot before a deploy)
#     BACKUP_DIR=/opt/longarm/backup
#     HEALTH_URL=https://<hub host>/healthz     # must report "version"
#     RUN_ARGS=(--restart unless-stopped --network <net> -p 7443:7443/tcp -p 7443:7443/udp
#               -v longarm-hub-data:/data:z -v /opt/longarm/hub.toml:/etc/longarm-hub/hub.toml:ro ...)
#     CMD=(container)
# ~<user>/.ssh/authorized_keys (a user in the docker group; one line):
#   restrict,command="/usr/local/bin/longarm-hub-deploy-docker" ssh-ed25519 AAAA... longarm-ci
#
# Commands (SSH_ORIGINAL_COMMAND, or the arguments when run by hand):
#   check <version>     pull the image, run its --version: change nothing
#   deploy <version>    check, snapshot the data volume, keep the running container as
#                       <NAME>-prev, start the new one, wait for HEALTH_URL to report
#                       <version> (90 s); on failure put the snapshot and the previous
#                       container back
#   rollback            swap <NAME> and <NAME>-prev (the data stays), health check
#   status              the images of <NAME> and <NAME>-prev, HEALTH_URL
#
# Exit status: 0 ok, 1 failed and rolled back (or nothing changed), 2 refused,
# 3 failed and the rollback failed too: look at the hub.
set -euo pipefail
umask 022
export LC_ALL=C PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.]{0,31})?$'
CONF=${LONGARM_HUB_DEPLOY_CONF:-/etc/longarm-hub-deploy-docker.conf}

log() {
	echo "longarm-hub-deploy: $*" >&2 2>/dev/null || true
	logger -t longarm-hub-deploy -- "$*" 2>/dev/null || true
}
die() {
	local code=$1
	shift
	log "error: $*"
	exit "$code"
}

[[ -r $CONF ]] || die 2 "no $CONF"
# shellcheck source=/dev/null
source "$CONF"
for v in IMAGE NAME VOLUME BACKUP_DIR HEALTH_URL; do
	[[ -n ${!v:-} ]] || die 2 "$CONF: $v is not set"
done
[[ ${#RUN_ARGS[@]} -gt 0 ]] || die 2 "$CONF: RUN_ARGS is not set"
[[ -n ${CMD+x} ]] || CMD=(container)

# health <version>: HEALTH_URL reports it within 90 s
health() {
	local want=$1 got=""
	for _ in $(seq 1 45); do
		got=$(curl -fsS -m 5 "$HEALTH_URL" 2>/dev/null | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' | head -1) || true
		[[ $got == "$want" ]] && return 0
		sleep 2
	done
	log "health: $HEALTH_URL reports ${got:-nothing}, not $want"
	return 1
}

check() {
	local v=$1
	docker pull -q "$IMAGE:$v" >/dev/null || die 1 "pull $IMAGE:$v failed"
	local out
	out=$(docker run --rm --network none "$IMAGE:$v" --version 2>&1) || die 1 "$IMAGE:$v --version: $out"
	[[ $out == *"$v"* ]] || die 2 "$IMAGE:$v reports \"$out\", not $v"
	log "check: $IMAGE:$v ok ($out)"
}

snapshot() {
	local f
	f="$BACKUP_DIR/$VOLUME-$(date -u +%Y%m%d%H%M%S).tgz"
	mkdir -p "$BACKUP_DIR"
	docker run --rm -v "$VOLUME:/data:ro" -v "$BACKUP_DIR:/backup" alpine tar czf "/backup/$(basename "$f")" -C /data . ||
		die 1 "snapshot of $VOLUME failed"
	echo "$f"
}

restore() { # restore <snapshot>
	docker run --rm -v "$VOLUME:/data" -v "$BACKUP_DIR:/backup:ro" alpine sh -c "find /data -mindepth 1 -delete && tar xzf /backup/$(basename "$1") -C /data"
}

deploy() {
	local v=$1 snap
	check "$v"
	docker inspect "$NAME" >/dev/null 2>&1 || die 2 "no container $NAME"
	docker stop -t 30 "$NAME" >/dev/null
	snap=$(snapshot) || {
		docker start "$NAME" >/dev/null
		die 1 "snapshot failed: $NAME left as it was"
	}
	log "snapshot: $snap"
	docker rm -f "$NAME-prev" >/dev/null 2>&1 || true
	docker rename "$NAME" "$NAME-prev"
	if docker run -d --name "$NAME" "${RUN_ARGS[@]}" "$IMAGE:$v" "${CMD[@]}" >/dev/null && health "$v"; then
		log "deployed $IMAGE:$v"
		return 0
	fi
	log "deploy of $v failed: rolling back"
	docker logs --tail 30 "$NAME" 2>&1 | while IFS= read -r l; do log "new: $l"; done || true
	docker rm -f "$NAME" >/dev/null 2>&1 || true
	restore "$snap" || die 3 "restoring $snap failed: the hub is down"
	docker rename "$NAME-prev" "$NAME" && docker start "$NAME" >/dev/null || die 3 "the previous container did not start"
	die 1 "rolled back to the previous container and the snapshot"
}

rollback() {
	docker inspect "$NAME-prev" >/dev/null 2>&1 || die 2 "no $NAME-prev"
	local prev
	prev=$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$NAME-prev")
	docker stop -t 30 "$NAME" >/dev/null 2>&1 || true
	docker rename "$NAME" "$NAME-rollback"
	docker rename "$NAME-prev" "$NAME"
	docker rename "$NAME-rollback" "$NAME-prev"
	docker start "$NAME" >/dev/null
	health "$prev" || die 3 "$prev did not come up after the rollback"
	log "rolled back to $prev"
}

status() {
	local c
	for c in "$NAME" "$NAME-prev"; do
		docker inspect -f "$c {{.Config.Image}} {{.State.Status}}" "$c" 2>/dev/null || echo "$c -"
	done
	curl -fsS -m 5 "$HEALTH_URL" || true
}

# shellcheck disable=SC2086,SC2048 # the command line's words, checked below
set -- ${SSH_ORIGINAL_COMMAND:-$*}
cmd=${1:-}
case $cmd in
status | rollback) [[ $# -eq 1 ]] || die 2 "usage: $cmd" ;;
check | deploy)
	[[ $# -eq 2 && $2 =~ $VERSION_RE ]] || die 2 "usage: $cmd <version>"
	;;
*)
	[[ $# -eq 1 && $1 =~ $VERSION_RE ]] || die 2 "usage: check|deploy <version> | rollback | status"
	set -- deploy "$1"
	cmd=deploy
	;;
esac
trap '' HUP PIPE # a dropped SSH session doesn't stop a deploy half-way
case $cmd in
status) status ;;
rollback) rollback ;;
check) check "$2" ;;
deploy) deploy "$2" ;;
esac
